--- a/cmake/modules/FindOpenVDB.cmake	2026-04-10 12:24:24.629805033 +0200
+++ b/cmake/modules/FindOpenVDB.cmake	2026-04-10 12:26:04.493050801 +0200
@@ -348,6 +348,23 @@
   return()
 endmacro()
 
+# ------------------------------------------------------------------
+# Prefer modern Imath (Gentoo, OpenEXR >= 3)
+# ------------------------------------------------------------------
+find_package(Imath QUIET)
+
+if (Imath_FOUND)
+  # Imath provides Half functionality; create compatibility target
+  if (TARGET Imath::Imath AND NOT TARGET IlmBase::Half)
+    add_library(IlmBase::Half ALIAS Imath::Imath)
+  elseif (TARGET Imath::Half AND NOT TARGET IlmBase::Half)
+    add_library(IlmBase::Half ALIAS Imath::Half)
+  endif()
+endif()
+
+# ------------------------------------------------------------------
+# Legacy IlmBase fallback (older distros / vendored builds)
+# ------------------------------------------------------------------
 find_package(IlmBase QUIET)
 if(NOT IlmBase_FOUND)
   pkg_check_modules(IlmBase QUIET IlmBase)
@@ -355,7 +372,7 @@
